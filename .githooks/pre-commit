#!/bin/sh

set -e

moon check

# Same format gate as CI's Format check (moon fmt --check, reject-only, never
# rewrites files): missing fmt locally is caught here instead of by CI (PR #10).
if ! moon fmt --check; then
  echo "pre-commit: format check failed - run 'moon fmt', re-stage, then commit again" >&2
  exit 1
fi
