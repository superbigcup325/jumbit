// 由一次性转译工具生成（源：上游 templates/nushell.txt），勿手改。
// 重命名：zoxide→jumbit、__zoxide_→__jumbit_、_ZO_→_JB_、z#→j#；Windows 分支已丢弃。

///|
/// nushell 模板渲染（自上游 templates/nushell.txt 转译：zoxide→jumbit、_ZO_→_JB_；勿手改）
pub fn render_nushell(
  cmd : String?,
  hook : Hook,
  echo : Bool,
  _resolve_symlinks : Bool,
) -> String {
  let sb = StringBuilder()
  let section : String = "# =============================================================================\n#"
  let not_configured : String = "# -- not configured --"
  sb.write_string("\n\n# Code generated by jumbit. DO NOT EDIT.\n\n")
  sb.write_string(section)
  sb.write_string("\n# Hook configuration for jumbit.\n#\n\n")
  if hook is HookNone {
    sb.write_string("\n")
    sb.write_string(not_configured)
  } else {
    sb.write_string(
      "\n# Initialize hook to add new entries to the database.\nexport-env {",
    )
    if hook is HookPrompt {
      sb.write_string(
        "\n  $env.config = (\n    $env.config?\n    | default {}\n    | upsert hooks { default {} }\n    | upsert hooks.pre_prompt { default [] }\n  )\n  let __jumbit_hooked = (\n    $env.config.hooks.pre_prompt | any { try { get __jumbit_hook } catch { false } }\n  )\n  if not $__jumbit_hooked {\n    $env.config.hooks.pre_prompt = ($env.config.hooks.pre_prompt | append {\n      __jumbit_hook: true,\n      code: {|| ^jumbit add -- $env.PWD}\n    })\n  }",
      )
    } else if hook is HookPwd {
      sb.write_string(
        "\n  $env.config = (\n    $env.config?\n    | default {}\n    | upsert hooks { default {} }\n    | upsert hooks.env_change { default {} }\n    | upsert hooks.env_change.PWD { default [] }\n  )\n  let __jumbit_hooked = (\n    $env.config.hooks.env_change.PWD | any { try { get __jumbit_hook } catch { false } }\n  )\n  if not $__jumbit_hooked {\n    $env.config.hooks.env_change.PWD = ($env.config.hooks.env_change.PWD | append {\n      __jumbit_hook: true,\n      code: {|_, dir| ^jumbit add -- $dir}\n    })\n  }",
      )
    }
    sb.write_string("\n}")
  }
  sb.write_string("\n\n")
  sb.write_string(section)
  sb.write_string(
    "\n# When using jumbit with --no-cmd, alias these internal functions as desired.\n#\n\n# Jump to a directory using only keywords.\nexport def --env --wrapped __jumbit_z [...rest: directory] {\n  match $rest {\n    [] => { cd ~ },\n    [ '-' ] => { cd - },\n    [ $arg ] if (try { cd $arg; true } catch { false }) => {},\n    _ => {\n      cd (^jumbit query --exclude $env.PWD -- ...$rest | str trim -r -c \"\\n\")\n    }\n  }",
  )
  if echo {
    sb.write_string("\n  echo $env.PWD")
  }
  sb.write_string(
    "\n}\n\n# Jump to a directory using interactive search.\nexport def --env --wrapped __jumbit_zi [...rest: string] {\n  cd $'(^jumbit query --interactive -- ...$rest | str trim -r -c \"\\n\")'",
  )
  if echo {
    sb.write_string("\n  echo $env.PWD")
  }
  sb.write_string("\n}\n\n")
  sb.write_string(section)
  sb.write_string("\n# Commands for jumbit. Disable these using --no-cmd.\n#")
  match cmd {
    Some(cmd) => {
      sb.write_string("\n\nexport alias ")
      sb.write_string(cmd)
      sb.write_string(" = __jumbit_z\nexport alias ")
      sb.write_string(cmd)
      sb.write_string("i = __jumbit_zi")
    }
    None => {
      sb.write_string("\n\n")
      sb.write_string(not_configured)
    }
  }
  sb.write_string("\n\n")
  sb.write_string(section)
  sb.write_string(
    "\n# Add this to your env file (find it by running `$nu.env-path` in Nushell):\n#\n#   jumbit init nushell | save -f ~/.jumbit.nu\n#\n# Now, add this to the end of your config file (find it by running\n# `$nu.config-path` in Nushell):\n#\n#   source ~/.jumbit.nu\n#\n# Note: jumbit only supports Nushell v0.106.0+.\n",
  )
  sb.to_string()
}
